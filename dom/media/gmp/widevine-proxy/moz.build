# What GMPInstallManager copies beside a downloaded x86_64 Widevine CDM on
# Linux ppc64le: the native proxy CDM Firefox loads in its place, the x86_64
# helper that runs the real CDM under box64, the gmp-helper launcher, and the
# x86_64 libgcc_s the CDM needs.
bundle = ("libwidevinecdm.so", "wvhost", "libgcc_s.so.1")
GENERATED_FILES += [bundle]
GENERATED_FILES[bundle].script = "build_proxy.py"
GENERATED_FILES[bundle].inputs = [
    "wvproxy.cc",
    "libgcc_s.c",
    "libgcc_s.map",
    "minilibc.h",
    "shim/cstdint",
    "shim/mozilla/DefineEnum.h",
    "shim/type_traits",
    "start.S",
    "wvhost.cc",
    "wvinput.h",
    "wvipc.h",
    "wvproxy.map",
    "/dom/media/gmp/widevine-adapter/content_decryption_module.h",
    "/dom/media/gmp/widevine-adapter/content_decryption_module_export.h",
]

FINAL_TARGET_FILES["widevine-proxy"] += [
    "!libwidevinecdm.so",
    "!wvhost",
    "gmp-helper",
]
FINAL_TARGET_FILES["widevine-proxy"].x64lib += [
    "!libgcc_s.so.1",
]
