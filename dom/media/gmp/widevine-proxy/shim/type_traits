#pragma once
namespace std {
template <class T>
struct is_standard_layout {
  constexpr operator bool() const { return __is_standard_layout(T); }
};
template <class T>
struct is_trivial {
  constexpr operator bool() const { return __is_trivial(T); }
};
}  // namespace std
